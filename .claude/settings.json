{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run verificar)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git checkout -b *)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(gh pr create:*)",
      "Edit(*.env*)",
      "Edit(netlify.toml)",
      "Edit(package.json)",
      "Edit(.github/workflows/*)",
      "Edit(.claude/settings.json)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push origin main)",
      "Bash(rm -rf:*)",
      "Bash(netlify deploy --prod:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh secret:*)",
      "Bash(gh api -X DELETE:*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/block-dangerous-bash.sh"
          }
        ]
      }
    ]
  },

  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com"
      ]
    }
  }
}
