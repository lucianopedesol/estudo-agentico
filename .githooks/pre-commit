#!/bin/sh
# Bloqueia commit direto na branch main/master.
# Guardrail local: o commit precisa acontecer numa branch de feature/infra/ci,
# nunca direto na branch protegida.

branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo ""
  echo "Commit bloqueado: você está na branch '$branch'."
  echo "Crie uma branch antes de commitar, ex.: git checkout -b feature/minha-mudanca"
  echo ""
  exit 1
fi

exit 0
